{
  "name": "zedox-browser",
  "version": "1.0.0",
  "description": "ZEDOX Browser — Privacy-first browser with zero-history, ephemeral cookies, and built-in ad blocking.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "zedox",
    "browser",
    "privacy",
    "adblock",
    "brave-alternative"
  ],
  "author": "ZEDOX Team",
  "license": "MIT",
  "dependencies": {
    "@cliqz/adblocker-electron": "^1.26.11",
    "cross-fetch": "^4.0.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.zedox.browser",
    "productName": "ZEDOX Browser",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
